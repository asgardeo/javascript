{
  "private": true,
  "name": "@asgardeo/prettier-config",
  "version": "0.0.0",
  "description": "Shared Prettier configuration for the Asgardeo JavaScript SDKs.",
  "keywords": [
    "asgardeo",
    "prettier",
    "prettier-config"
  ],
  "homepage": "https://github.com/asgardeo/javascript/tree/main/tooling/prettier-config#readme",
  "bugs": {
    "url": "https://github.com/asgardeo/javascript/issues"
  },
  "author": "WSO2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asgardeo/javascript",
    "directory": "tooling/prettier-config"
  },
  "scripts": {
    "build": "pnpm clean && rolldown -c rolldown.config.js && tsc -p tsconfig.lib.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "rimraf": "6.1.0",
    "rolldown": "1.0.0-beta.45",
    "typescript": "5.7.2"
  }
}
