{
  "private": true,
  "name": "@asgardeo/eslint-plugin",
  "version": "0.0.0",
  "description": "Shared ESLint plugin and flat configs for the Asgardeo JavaScript SDKs.",
  "keywords": [
    "asgardeo",
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "homepage": "https://github.com/asgardeo/javascript/tree/main/tooling/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/asgardeo/javascript/issues"
  },
  "author": "WSO2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/asgardeo/javascript",
    "directory": "tooling/eslint-plugin"
  },
  "scripts": {
    "build": "pnpm clean && rolldown -c rolldown.config.js && tsc -p tsconfig.lib.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit"
  },
  "dependencies": {
    "@eslint/js": "9.39.4",
    "@typescript-eslint/parser": "8.57.2",
    "@vitest/eslint-plugin": "1.6.13",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-vue": "10.8.0",
    "globals": "16.4.0",
    "typescript-eslint": "8.57.2"
  },
  "devDependencies": {
    "@asgardeo/prettier-config": "workspace:*",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/estree": "1.0.8",
    "@types/node": "22.15.3",
    "eslint": "9.39.5",
    "rimraf": "6.1.0",
    "rolldown": "1.0.0-beta.45",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "nx": {
    "targets": {
      "lint": {
        "dependsOn": [
          "^build",
          "build"
        ]
      },
      "fix:lint": {
        "dependsOn": [
          "^build",
          "build"
        ]
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  }
}
