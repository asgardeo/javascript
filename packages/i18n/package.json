{
  "name": "@asgardeo/i18n",
  "version": "1.0.1",
  "description": "Internationalization (i18n) package for Asgardeo JavaScript SDKs.",
  "keywords": [
    "asgardeo",
    "i18n",
    "internationalization",
    "localization"
  ],
  "homepage": "https://github.com/asgardeo/javascript/tree/main/packages/i18n#readme",
  "bugs": {
    "url": "https://github.com/asgardeo/javascript/issues"
  },
  "author": "WSO2",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/cjs/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/asgardeo/javascript",
    "directory": "packages/i18n"
  },
  "scripts": {
    "build": "pnpm clean && node esbuild.config.mjs && tsc -p tsconfig.lib.json --emitDeclarationOnly --outDir dist && node ../../scripts/fix-dist-module-types.mjs",
    "clean": "rimraf dist",
    "fix:lint": "eslint . --fix",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit"
  },
  "devDependencies": {
    "@asgardeo/eslint-plugin": "workspace:*",
    "@asgardeo/prettier-config": "workspace:*",
    "@types/node": "22.15.30",
    "esbuild": "0.25.9",
    "eslint": "9.39.5",
    "prettier": "3.6.2",
    "rimraf": "6.1.0",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
